#include <Arduino.h>
#include "dependencies.h"

void setup() {
  Serial.begin(9600);
  connectWiFi();
  selectTimeZone();   // prompt user for zone
  initSensors();
  initSwitches();
}

void loop() {
  // Node 1 button
  if (isNode1Pressed()) {
    Serial.println("Node_1 pressed — sending data...");
    float temp = readTemperature();
    float hum = readHumidity();

    if (!isnan(temp) && !isnan(hum)) {
      incrementNode1Count();
      transmit(temp, hum, "NODE_1");
    } else {
      Serial.println("Sensor error!");
    }
    delay(1000);
  }

  // Node 2 button
  if (isNode2Pressed()) {
    Serial.println("Node_2 pressed — sending data...");
    float temp = readTemperature();
    float hum = readHumidity();

    if (!isnan(temp) && !isnan(hum)) {
      incrementNode2Count();
      transmit(temp, hum, "NODE_2");
    } else {
      Serial.println("Sensor error!");
    }
    delay(1000);
  }

  delay(100);
}
