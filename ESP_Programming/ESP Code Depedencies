// ===== Wi-Fi Setup =====
const char* ssid     = "BananaHammock";
const char* password = "Sonoma2021!";

void connectWiFi() {
  Serial.println();
  Serial.print("Connecting to ");
  Serial.println(ssid);
  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nWiFi connected!");
  Serial.print("IP address: ");
  Serial.println(WiFi.localIP());
}

// ===== DHT Sensor Setup =====
#define DHTPIN D4
#define DHTTYPE DHT11
DHT dht(DHTPIN, DHTTYPE);

void initSensors() {
  dht.begin();
}

float readTemperature() {
  return dht.readTemperature();
}

float readHumidity() {
  return dht.readHumidity();
}

// ===== Switch Setup =====
#define SWITCH_NODE1 D5   // Node 1 button
#define SWITCH_NODE2 D6   // Node 2 button

void initSwitches() {
  pinMode(SWITCH_NODE1, INPUT_PULLUP);
  pinMode(SWITCH_NODE2, INPUT_PULLUP);
}

bool isNode1Pressed() {
  return digitalRead(SWITCH_NODE1) == LOW;  // Active LOW
}

bool isNode2Pressed() {
  return digitalRead(SWITCH_NODE2) == LOW;  // Active LOW
}

