// ===== Time-Zone Selection =====
String selectedTimeZone = "America/Los_Angeles"; // default PT

void selectTimeZone() {
  Serial.println("→ Select Your Time Zone (default PT - Pacific):");
  Serial.println("1) ET  - Eastern (New York)");
  Serial.println("2) CT  - Central (Chicago)");
  Serial.println("3) MT  - Mountain (Denver)");
  Serial.println("4) PT  - Pacific (Los Angeles)");
  Serial.println("5) AKT - Alaska (Anchorage)");
  Serial.println("6) HAT - Hawaii-Aleutian (Honolulu)");
  Serial.println("7) AT  - Atlantic (San Juan)");
  Serial.print("Enter number (1–7): ");

  unsigned long start = millis();
  while (!Serial.available() && (millis() - start < 15000)) delay(100);

  if (Serial.available()) {
    int choice = Serial.parseInt();
    switch (choice) {
      case 1: selectedTimeZone = "America/New_York"; break;
      case 2: selectedTimeZone = "America/Chicago"; break;
      case 3: selectedTimeZone = "America/Denver"; break;
      case 4: selectedTimeZone = "America/Los_Angeles"; break;
      case 5: selectedTimeZone = "America/Anchorage"; break;
      case 6: selectedTimeZone = "Pacific/Honolulu"; break;
      case 7: selectedTimeZone = "America/Puerto_Rico"; break;
      default: selectedTimeZone = "America/Los_Angeles"; break;
    }
    Serial.print("Time zone set to: ");
    Serial.println(selectedTimeZone);
  } else {
    Serial.println("\nNo input detected — using default Pacific Time (PT)");
  }
}

// ===== Real-Time Fetch from TimeAPI.io =====
String readTime() {
  WiFiClientSecure client;
  client.setInsecure();
  HTTPClient http;

  String url = "https://timeapi.io/api/Time/current/zone?timeZone=" + selectedTimeZone;
  Serial.println("Requesting time from: " + url);

  http.begin(client, url);
  int httpCode = http.GET();

  if (httpCode == 200) {
    String payload = http.getString();
    StaticJsonDocument<512> doc;
    DeserializationError error = deserializeJson(doc, payload);

    if (!error) {
      String dateTime = doc["dateTime"];
      dateTime.replace("T", " ");
      dateTime.remove(19); // drop milliseconds
      Serial.println("Formatted time: " + dateTime);
      return dateTime;
    } else {
      Serial.println("JSON parse error!");
      return "1970-01-01 00:00:00";
    }
  } else {
    Serial.printf("TimeAPI error: %d\n", httpCode);
    return "1970-01-01 00:00:00";
  }

  http.end();
}

// ===== Data Transmission (HTTPS + Base64) =====
void transmit(float temp, float hum, const char* nodeName) {
  if (WiFi.status() == WL_CONNECTED) {
    WiFiClientSecure client;
    client.setInsecure();
    HTTPClient http;

    http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
    http.setTimeout(15000);
    http.addHeader("User-Agent", "ESP8266SensorClient");

    // Get real time
    String timeNow = readTime();
    timeNow.replace(" ", "%20");

    // Build Base64 message
    String msg = "nodeId=" + String(nodeName) +
                 "&nodeTemp=" + String(temp, 2) +
                 "&nodeHum=" + String(hum, 2) +
                 "&timeReceived=" + timeNow;

    String encoded = base64::encode(msg);
    String url = "https://www.cmontanoee.com/db_insert.php?msg=" + encoded;

    Serial.println("Sending data to: " + url);

    http.begin(client, url);
    int httpCode = http.GET();

    if (httpCode > 0) {
      String payload = http.getString();
      Serial.printf("Server response (%d): %s\n", httpCode, payload.c_str());
    } else {
      Serial.printf("HTTP error: %s\n", http.errorToString(httpCode).c_str());
    }

    http.end();
  } else {
    Serial.println("WiFi not connected!");
  }
}

#endif
