-- View of Combined Data
CREATE VIEW sensor_combined AS
SELECT 
    r.node_name,
    r.manufacturer,
    r.longitude,
    r.latitude,
    d.time_received,
    d.temperature,
    d.humidity
FROM sensor_register r
JOIN sensor_data d
    ON r.node_name = d.node_name;
